{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional structured inventory; input-defined",
  "type": "object",
  "required": [
    "sections",
    "expected_total_marks"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "expected_total_marks": {
      "type": "number",
      "minimum": 0
    },
    "units": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
